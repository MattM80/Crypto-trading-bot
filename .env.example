# Kraken Spot API credentials
# Get yours at: https://www.kraken.com/u/security/api
# Required permissions: Query Funds, Trade, Query Trades
KRAKEN_API_KEY=your_api_key_here
KRAKEN_PRIVATE_KEY=your_private_key_here

# Trading mode (default: false = dry run, no real orders)
ENABLE_LIVE_TRADING=false

# Starting balance in USD (used for position sizing calculations)
STARTING_BALANCE=300

# Bot check interval in seconds (default: 300 = 5 minutes)
CHECK_INTERVAL=300
