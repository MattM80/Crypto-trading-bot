# Kraken Spot API credentials
# Get yours at: https://www.kraken.com/u/security/api
# Required permissions: Query Funds, Trade, Query Trades
KRAKEN_API_KEY=your_api_key_here
KRAKEN_PRIVATE_KEY=your_private_key_here

# Trading mode (default: false = dry run, no real orders)
ENABLE_LIVE_TRADING=false

# Production constraint: Kraken spot only. Short detectors are used as defensive
# risk overlays, not as trade routes.
SPOT_ONLY_MODE=true
EVIDENCE_MODE=true
VALIDATION_ACCOUNT_MODE=true
ENABLE_EXTERNAL_SIGNAL_EXPORT=false
FORWARD_TOOL_STRICT_VALIDATION=true
ENABLE_QUALITY_UNIVERSE=true
ENABLE_ASSET_CONTEXT_GUARD=true
ASSET_CONTEXT_MAX_MARKET_CAP_RANK=150
ASSET_CONTEXT_MIN_24H_CHANGE_PCT=-18
ASSET_CONTEXT_MIN_7D_CHANGE_PCT=-35
ASSET_CONTEXT_CACHE_TTL_SEC=21600
ASSET_CONTEXT_BLOCK_UNMAPPED=false
MARKET_BREADTH_RECOVERY_ENABLED=true
MARKET_BREADTH_RECOVERY_MIN_BULLISH_PCT=55
MARKET_BREADTH_RECOVERY_MAX_SHORT_DOMINANCE=1.15
MARKET_BREADTH_RECOVERY_MIN_RET_4H=0.6
MARKET_BREADTH_RECOVERY_MIN_RET_24H=1.2
MARKET_BREADTH_RECOVERY_MIN_VOLUME_RATIO=1.05
MARKET_BREADTH_RECOVERY_MAX_RSI=72
MARKET_BREADTH_RECOVERY_MIN_RANGE_POS=0.55
MARKET_BREADTH_RECOVERY_BTC_MIN_RET_24H=0.4

# Autonomous gate proof ladder. Scout proof can only slightly relax score
# floors; real clean live closes are required before stack/bull gates relax or
# sizing gets a modest lift.
AUTONOMOUS_PROOF_LADDER_ENABLED=true
PROOF_VALIDATED_MIN_TRADES=8
PROOF_TRUSTED_MIN_TRADES=15
PROOF_VALIDATED_MIN_WIN_RATE=0.53
PROOF_TRUSTED_MIN_WIN_RATE=0.56
PROOF_VALIDATED_MIN_AVG_PNL_PCT=0.004
PROOF_TRUSTED_MIN_AVG_PNL_PCT=0.006

# Opportunity scout: records blocked/rejected long candidates as paper forward
# observations in logs/opportunity_scout.csv. It does not place trades.
OPPORTUNITY_SCOUT_ENABLED=true
OPPORTUNITY_SCOUT_MIN_SCORE=12
OPPORTUNITY_SCOUT_HORIZON_BARS=24
OPPORTUNITY_SCOUT_MAX_PENDING=300
OPPORTUNITY_SCOUT_PROOF_MIN_SAMPLES=16
OPPORTUNITY_SCOUT_PROOF_MIN_WIN_RATE=0.58
OPPORTUNITY_SCOUT_PROOF_MIN_AVG_PNL_PCT=0.005

# Small-account validation defaults. Keep these conservative until forward
# eligible PnL and profit factor pass the validation bar.
MAX_ACTIVE_POSITIONS=4
RISK_PER_TRADE=0.04
MAX_POSITION_PCT=0.10
MAX_TOTAL_EXPOSURE_PCT=0.55
BULL_OFFENSE_SIZE_MULT=1.05
BULL_OFFENSE_TOTAL_EXPOSURE_PCT=0.65
BULL_OFFENSE_POSITION_PCT=0.12

# ---- Dormant futures scaffold ---------------------------------------------
# Ignored while SPOT_ONLY_MODE=true. Keep disabled for this account.
ENABLE_FUTURES_TRADING=false
KRAKEN_FUTURES_API_KEY=
KRAKEN_FUTURES_PRIVATE_KEY=
# Max USD notional on any single futures short (safety cap for early rollout):
FUTURES_SHORT_MAX_NOTIONAL_USD=25
# Max leverage used on a futures short (Kraken permits up to 50x; keep very low):
FUTURES_SHORT_MAX_LEVERAGE=2

# Starting balance in USD (used for position sizing calculations)
STARTING_BALANCE=300

# Bot check interval in seconds (default: 300 = 5 minutes)
CHECK_INTERVAL=300

# Active crypto Fear & Greed source. The bot reads CoinMarketCap's live public
# page state first because the official historical API can lag the visible dial.
# COINMARKETCAP_API_KEY is optional and used only as a fresh fallback. Do not use
# CNN's stock-market Fear & Greed here.
FNG_PROVIDER=coinmarketcap
COINMARKETCAP_API_KEY=
CMC_FNG_API_URL=https://pro-api.coinmarketcap.com/v3/fear-and-greed/historical
CMC_FNG_PAGE_URL=https://coinmarketcap.com/charts/fear-and-greed-index/
FNG_CACHE_TTL_SEC=300
FNG_MAX_SOURCE_AGE_HOURS=36
FNG_LAST_GOOD_MAX_AGE_HOURS=6
